<?xml version="1.0" encoding="utf-8"?>
<!--
  Da Android 12 allowBackup="false" non blocca il trasferimento da dispositivo
  a dispositivo. Escludiamo tutti i dati dell'app (cache con le scansioni
  incluse) sia dal backup cloud sia dal trasferimento.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
